# Keep verifier-only binary assets out of normal Git objects. A complete clone
# requires Git LFS so the Harbor verifier remains reproducible and offline.
tests/e2e-data/params/*.npz filter=lfs diff=lfs merge=lfs -text
tests/wheels/*.whl filter=lfs diff=lfs merge=lfs -text
tests/wheels/*.tar.gz filter=lfs diff=lfs merge=lfs -text

*.sh text eol=lf
Dockerfile text eol=lf
